# ──────────────────────────────────────────────────────────────────────────────
# Discord Server Analytics Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Required ─────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# Database ─────────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to project root)
DATABASE_URL=sqlite:///surveys.db
DB_PATH=data/analytics.db

# For higher scale or multiple bot instances, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Web server ───────────────────────────────────────────────────────────────────
# Port for the health-check HTTP server (Render injects PORT automatically)
PORT=8080
API_MAX_BODY_MB=10
API_CORS_ORIGIN=*

# Timezone / Localisation ──────────────────────────────────────────────────────
# IANA timezone name — used as the default for guilds that haven't configured one
DEFAULT_TIMEZONE=Asia/Bangkok

# Logging ──────────────────────────────────────────────────────────────────────
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
